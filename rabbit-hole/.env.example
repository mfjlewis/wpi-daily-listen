# Required for real translation, tagging, screenshot reading and search.
# Without it the app runs in demo mode. Get a key at console.anthropic.com
# (billed separately from a Claude Pro/Max subscription).
ANTHROPIC_API_KEY=

# Passphrase for signing in. Always set this on a server that's reachable
# from the internet.
APP_TOKEN=

# Where the archive is stored (plain files). On a host, point this at a
# persistent disk.
DATA_DIR=./data

PORT=3000
