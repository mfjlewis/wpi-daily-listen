{
  "manifest_version": 3,
  "name": "Rabbit Hole",
  "version": "0.1.0",
  "description": "Save the page you're reading to your Rabbit Hole research archive: translated, tagged, citable, and ready to listen to.",
  "action": {
    "default_title": "Save to Rabbit Hole (Alt+Shift+S)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Rabbit Hole"
    }
  }
}
