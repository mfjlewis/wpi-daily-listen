# From the OAuth client you create in the wherepeteris.com Google Cloud project
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Public https URL of this server, no trailing slash
BASE_URL=https://editor-mail-xxxxxxxxxx.us-central1.run.app
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me
# Only this Google account may use the connector
ALLOWED_EMAIL=editor@wherepeteris.com
